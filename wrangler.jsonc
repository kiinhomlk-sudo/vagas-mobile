{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "seasonaljobs-worker",

  "main": "src/index.js",

  "compatibility_date": "2026-08-15",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seasonaljobs",
      "database_id": "00000005-00000000-000050cc-90c46ae12a0e0103c859c55b9a9df506"
    }
  ],

  "triggers": {
    "crons": [
      "0 5 * * *"
    ]
  }
}
