{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seasonaljobs-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-08-15",

  "kv_namespaces": [
    {
      "binding": "JOBS",
      "id": "COLOQUE_O_ID_DO_SEU_KV_AQUI"
    }
  ],

  "triggers": {
    "crons": [
      "0 5 * * *"
    ]
  }
}
